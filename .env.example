# Copy this file to .env and fill in your values.

# Generate a strong key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# PostgreSQL
DB_NAME=bali_rent
DB_USER=bali_rent_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
STATIC_ROOT=/var/www/bali_rent/static
MEDIA_ROOT=/var/www/bali_rent/media

# Optional compatibility fallback if you still use a single connection string somewhere.
# DATABASE_URL=postgres://bali_rent_user:change-me@127.0.0.1:5432/bali_rent

# CORS / CSRF
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Production security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Optional infrastructure
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Optional payment settings
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
CRYPTO_PAYMENT_API_KEY=
CRYPTO_PAYMENT_WEBHOOK_SECRET=
