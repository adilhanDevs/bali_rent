# Copy this file to .env and fill in your values.

# Generate a strong key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-strong-secret-key
DEBUG=False
ALLOWED_HOSTS=bali.bike,www.bali.bike,api.bali.bike,localhost,127.0.0.1

# PostgreSQL
DB_NAME=bali_rent
DB_USER=bali_rent_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
STATIC_ROOT=/var/www/bali_rent/static
MEDIA_ROOT=/var/www/bali_rent/media

# Optional compatibility fallback if you still use a single connection string somewhere.
# DATABASE_URL=postgres://bali_rent_user:change-me@127.0.0.1:5432/bali_rent

# CORS / CSRF
# Add http://localhost:3000 (Next.js dev) and http://localhost:19006 / 8081 (Expo web dev)
# here when testing locally against this backend. Native mobile requests (Expo Go on
# iOS/Android) don't send an Origin header, so CORS doesn't apply to them.
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://bali.bike,https://www.bali.bike,https://api.bali.bike,http://localhost:3000,http://localhost:19006,http://localhost:8081
CSRF_TRUSTED_ORIGINS=https://bali.bike,https://www.bali.bike,https://api.bali.bike,http://localhost:3000,http://localhost:19006,http://localhost:8081

# Production security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Scoped API throttles for sensitive endpoints only
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_PRICING_CALCULATE=60/min
THROTTLE_PROMO_VALIDATE=30/min
THROTTLE_ANALYTICS_EVENTS=120/min
THROTTLE_PAYMENT_CREATE=20/min

# JWT sessions
JWT_ACCESS_LIFETIME_MINS=43200
JWT_REFRESH_LIFETIME_DAYS=3650
JWT_ROTATE_REFRESH_TOKENS=false
JWT_BLACKLIST_AFTER_ROTATION=false

# Optional infrastructure
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Optional payment settings
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_CANCEL_URL=
CRYPTO_PAYMENT_API_KEY=
CRYPTO_PAYMENT_WEBHOOK_SECRET=
